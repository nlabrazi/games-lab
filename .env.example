# Dossier local lu par /api/dos-games en developpement.
# Copier localement lands-of-lore.jsdos dans ce dossier pour tester sans VPS.
DOS_GAMES_DIR=local/dos-games

# Dossier serveur ou les sauvegardes MS-DOS seront ecrites.
# En production Docker/VPS, ce chemin devra pointer vers un volume persistant.
DOS_SAVES_DIR=local/dos-saves
DOS_SAVES_API_TOKEN=change-me-with-a-long-random-secret

# URL appelee par le player js-dos dans le navigateur.
NUXT_PUBLIC_DOS_GAMES_BASE_URL=/api/dos-games
